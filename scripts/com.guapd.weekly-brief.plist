<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.guapd.weekly-brief</string>

  <!-- Through a login shell, so the agent inherits the same PATH and
       credentials a terminal has. launchd's own environment is nearly empty
       and `claude` would simply not be found. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>$HOME/platform/scripts/weekly-brief.sh</string>
  </array>

  <!-- Mondays at 09:00 local. StartCalendarInterval, not StartInterval:
       launchd RUNS A MISSED JOB once the machine wakes, where a plain cron
       entry would skip the week entirely if the Mac happened to be asleep at
       nine on a Monday. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key><integer>1</integer>
    <key>Hour</key><integer>9</integer>
    <key>Minute</key><integer>0</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/tmp/guapd-weekly-brief.out.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/guapd-weekly-brief.err.log</string>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
